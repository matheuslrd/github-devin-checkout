{
  "manifest_version": 3,
  "name": "Contato Seguro",
  "version": "2.1.0",
  "description": "Botões customizados da Contato Seguro no GitHub e em outros contextos.",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "css": ["content.css"],
      "js": [
        "src/registry.js",
        "src/config.js",
        "src/shared.js",
        "src/buttons/checkout-branches.js",
        "src/buttons/review-pr-card.js",
        "src/runtime.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
